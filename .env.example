# Google Sheets (required)
# Spreadsheet ID or full https://docs.google.com/spreadsheets/d/<id>/edit URL
GOOGLE_SHEET_ID=

# Service-account JSON key path, or the JSON itself
# GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
# Alternative to the JSON file:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: name of the config tab (default: config)
# CONFIG_TAB=config

# How often to re-read the config tab. 5000ms = 12 reads/min, under Google's
# 60 reads/minute/user quota.
# CONFIG_POLL_MS=5000

# Closed-candle polling while an exchange is in session
# SAMPLE_MS=15000
# CLOSE_GRACE_MS=2000

# Optional WebSocket overrides
# WS_DC=blr1
# WS_TAG=go-charting-scraper
# WS_HOST=wss://origin.ws.prodb.blr1.gocharting.com/blr1/ws
# GOCHARTING_SESSION=RTH
# TOKEN_REFRESH_MS=2700000

# Optional local CSV in addition to Google Sheets
# WRITE_CSV=0
# CSV_PATH=./logs/maxvol.csv

# Logs (gitignored)
# ERROR_LOG_PATH=./logs/error.log
# STATUS_PATH=./logs/status.json

# One sample then exit (smoke test / cron)
# ONCE=1

# Protobuf schemas (default: src/proto next to env.js, or ./proto in a packed zip)
# PROTO_DIR=./src/proto
