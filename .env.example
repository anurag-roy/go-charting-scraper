# GoCharting credentials (required)
GOCHARTING_EMAIL=
GOCHARTING_PASSWORD=

# Playwright
HEADLESS=1
# PW_CHANNEL=chrome

# Instrument (NSE Nifty current-month futures)
GOCHARTING_EXCHANGE=NSE
GOCHARTING_SEGMENT=FUTURE
GOCHARTING_SYMBOL=NIFTY-I
GOCHARTING_SESSION=RTH
# Optional: a saved terminal URL used only for login / JWT
# CHART_URL=https://gocharting.com/terminal/chart/kd5OXEIXs

# Candles
INTERVALS=2m,3m,5m
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
# Wait this long after a bar's end before treating it as closed
CLOSE_GRACE_MS=2000

# Sampling: omit RUN_MS to poll until 15:30 IST (weekdays).
# RUN_MS=0  → one-shot backfill of closed candles, then exit
# SAMPLE_MS=15000
# TOKEN_REFRESH_MS=2700000

# At least one output sink is required: GOOGLE_SHEET_ID and/or WRITE_CSV=1

# Google Sheets (share the spreadsheet with the service account email as Editor)
# Spreadsheet ID or full https://docs.google.com/spreadsheets/d/<id>/edit URL
GOOGLE_SHEET_ID=
# Path to the service-account JSON key, or the JSON itself
# GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
# Alternative to the JSON file:
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Local CSV (opt-in). Can be used with or without Google Sheets.
WRITE_CSV=0
# CSV_PATH=./investigation/evidence/maxvol.csv
